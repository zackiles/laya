export PULUMI_CONFIG_PASSPHRASE_FILE="$HOME/.config/pulumi/laya-development.passphrase"

if [ ! -s "$PULUMI_CONFIG_PASSPHRASE_FILE" ]; then
  mkdir -p "$(dirname "$PULUMI_CONFIG_PASSPHRASE_FILE")"
  (umask 077 && gcloud secrets versions access latest --secret=laya-pulumi-passphrase --project=nesto-platform-ai > "$PULUMI_CONFIG_PASSPHRASE_FILE") ||
    rm -f "$PULUMI_CONFIG_PASSPHRASE_FILE"
fi
